# Free Zerodha Live Sync (Web Session Token)
# Paste your browser's enctoken cookie from kite.zerodha.com here:
ZERODHA_ENCTOKEN=your_enctoken_cookie_value_here

# Zerodha Kite Connect API Credentials (Optional - Paid API)
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_REDIRECT_URL=http://127.0.0.1:8000/api/v1/auth/callback

# Application Settings
DEMO_MODE=false
APP_HOST=127.0.0.1
APP_PORT=8000

# Phase 3 — AI Advisory Engine
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_PROVIDER=gemini  # "gemini" | "ollama"

# Ollama (self-hosted, optional — for stricter data privacy)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Redis Cache Settings
REDIS_URL=redis://localhost:6379/0
HOLDINGS_CACHE_TTL=300
ADVISORY_CACHE_TTL=1800
